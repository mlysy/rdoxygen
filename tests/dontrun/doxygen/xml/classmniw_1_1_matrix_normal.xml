</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">ldSigmaR</parametername>
</parameternamelist>
<parameterdescription>
<para>Log-determinant of <computeroutput>cholSigmaR</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">cholSigmaC</parametername>
</parameternamelist>
<parameterdescription>
<para>Lower Cholesky factor of column-variance matrix, as an <computeroutput>Eigen::LLT</computeroutput> object.</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">ldSigmaC</parametername>
</parameternamelist>
<parameterdescription>
<para>Log-determinant of <computeroutput>cholSigmaC</computeroutput>.</para></parameterdescription>
</parameteritem>
</parameterlist>
