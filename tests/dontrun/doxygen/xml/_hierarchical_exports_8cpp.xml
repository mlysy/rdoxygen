        <detaileddescription>
<para>Bayesian inference for the Hierarchical Normal Unequal-Variance model.</para><para>Generate <computeroutput>nSamples</computeroutput> draws from a Gibbs sampler on the posterior random-effect and hyperparameter distribution of the Hierarchical Normal Unequal-Variance model.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">nSamples</parametername>
</parameternamelist>
<parameterdescription>
<para>Integer number of posterior draws to return. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">nBurn</parametername>
</parameternamelist>
<parameterdescription>
<para>Integer number of samples to initially discard as burn-in. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Y</parametername>
</parameternamelist>
<parameterdescription>
<para>Response matrix of size <computeroutput>N x q</computeroutput>, each row is an observation. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">X</parametername>
</parameternamelist>
<parameterdescription>
<para>Covariate matrix of size <computeroutput>N x q</computeroutput>, each row is an observation. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">V</parametername>
</parameternamelist>
<parameterdescription>
<para>Matrix of size <computeroutput>q x (Nq)</computeroutput> containing the variance of each response about its mean. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Lambda</parametername>
</parameternamelist>
<parameterdescription>
<para>Prior mean matrix of size <computeroutput>p x q</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Omega</parametername>
</parameternamelist>
<parameterdescription>
<para>Prior row-wise precision matrix of size <computeroutput>p x p</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Psi</parametername>
</parameternamelist>
<parameterdescription>
<para>Prior column-wise scale matrix of size <computeroutput>q x q</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">nu</parametername>
</parameternamelist>
<parameterdescription>
<para>Prior shape parameter. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Beta0</parametername>
</parameternamelist>
<parameterdescription>
<para>Initial random-effects coefficient matrix of size <computeroutput>p x q</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">iSigma0</parametername>
</parameternamelist>
<parameterdescription>
<para>Initial random-effects precision matrix of size <computeroutput>q x q</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Mu0</parametername>
</parameternamelist>
<parameterdescription>
<para>Initial random-effects matrix of size <computeroutput>N x q</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">updateBetaSigma</parametername>
</parameternamelist>
<parameterdescription>
<para>Boolean; whether or not to update the random-effects mean and variance matrices <computeroutput>Beta</computeroutput> and <computeroutput>Sigma</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">updateMu</parametername>
</parameternamelist>
<parameterdescription>
<para>Boolean; whether or not to update the random-effects <computeroutput>Mu</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">storeBetaSigma</parametername>
</parameternamelist>
<parameterdescription>
<para>Boolean; whether or not to return <computeroutput>Beta</computeroutput> and <computeroutput>Sigma</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">storeMu</parametername>
</parameternamelist>
<parameterdescription>
<para>Boolean; whether or not to return <computeroutput>Mu</computeroutput>.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput>Rcpp::List</computeroutput> with elements <computeroutput>Beta</computeroutput>, <computeroutput>Sigma</computeroutput>, and <computeroutput>Mu</computeroutput>, being matrices of size <computeroutput>p x (q*nSamples)</computeroutput>, <computeroutput>q x (q*nSamples)</computeroutput> and <computeroutput>q x (N*nSamples)</computeroutput>. </para></simplesect>
</para>        </detaileddescription>
